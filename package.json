{
  "name": "hauldesk",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source order catalog, multi-vendor parcel organizer and flatlay outfit builder for Superbuy and agent hauls.",
  "homepage": "https://github.com/DDT2943/HaulDesk",
  "license": "MIT",
  "author": "HaulDesk Contributors",
  "desktopName": "hauldesk.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "build:extension": "vite build --config vite.config.extension.ts",
    "pack:extension": "npm run build:extension && tsx scripts/pack-extension.ts",
    "build:portable": "tsx scripts/build-portable.ts",
    "electron:prepare": "npm run build && npm run pack:extension && npm run build:server",
    "electron:build:linux": "npm run electron:prepare && electron-builder --linux --x64 --publish never",
    "electron:build:win": "npm run electron:prepare && electron-builder --win --x64 --publish never",
    "electron:build:mac": "npm run electron:prepare && electron-builder --mac --x64 --arm64 --publish never",
    "electron:build:mac:arm64": "npm run electron:prepare && electron-builder --mac --arm64 --publish never",
    "electron:build:mac:x64": "npm run electron:prepare && electron-builder --mac --x64 --publish never",
    "test": "tsx --test tests/*.test.ts src/utils/*.test.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-extension release release-desktop",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "onnxruntime-node": "^1.31.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.7.0",
    "react-use-measure": "^2.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
