# ==============================================================================
# HaulDesk — Environment Configuration Template
# Copy this file to .env and adjust values for your setup.
# NEVER commit .env or any credentials/certificates to Git.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Docker Compose Host Port Binding (127.0.0.1:<HAULDESK_HOST_PORT>:3000)
# Standard local default is 3000. If your reverse proxy targets another port (e.g. 3003), set it here.
HAULDESK_HOST_PORT=3000

# Persistent Storage Directory (stores hauldesk-db.json and downloaded u2netp.onnx weights)
# Docker container uses /app/data (mounted to ./data); Desktop app uses OS userData directory.
DATA_DIR=./data

# CORS / Reverse Proxy Origin Configuration
# Localhost, same-host requests, and Firefox/Chrome browser extensions are permitted automatically.
APP_URL="http://localhost:3000"
# Optional comma-separated extra origins if needed behind multiple domains:
ALLOWED_ORIGINS=""

# Optional Outfit Flatlay AI Background Removal (MIT onnxruntime-node + Apache-2.0 u2netp.onnx)
# Set to "true" to disable downloading/running the segmentation model and use fast canvas cutout only.
DISABLE_AI_BG_REMOVAL="false"
# Optional custom local path to pre-downloaded u2netp.onnx weights:
BG_REMOVAL_MODEL_PATH=""

# Optional Gemini API Flag (kept disabled by default for 100% offline/local operation)
DISABLE_AI_ANALYSIS="true"
GEMINI_API_KEY=""
