{
  "manifest_version": 2,
  "name": "HaulDesk Quick Add",
  "version": "1.0.0",
  "description": "Catalog Yupoo, Taobao, Weidian, and Superbuy items straight into HaulDesk in 4 guided steps.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "HaulDesk — Quick Add",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "HaulDesk — Quick Add",
    "default_panel": "popup.html?mode=sidebar",
    "open_at_install": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hauldesk-quickadd@hauldesk.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
